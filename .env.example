# ==============================================================================
# ALTA FANTASIA — MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha as suas credenciais.
# ==============================================================================

# BANCO DE DADOS (MySQL via PDO)
# Padrão Docker: DB_HOST=db / DB_PASS=root_password
# Padrão XAMPP: DB_HOST=127.0.0.1 / DB_PASS= (vazio)
DB_HOST=db
DB_PORT=3306
DB_NAME=altafantasia
DB_USER=root
DB_PASS=root_password
DB_CHARSET=utf8mb4

# CLOUDFLARE TURNSTILE (CAPTCHA)
CLOUDFLARE_TURNSTILE_SITEKEY=
CLOUDFLARE_TURNSTILE_SECRET=

# CLOUDFLARE API & R2 STORAGE
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=altafantasia
CLOUDFLARE_R2_PUBLIC_URL=

# GOOGLE OAUTH
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLIENT_SECRET=

# APLICAÇÃO
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/myprojects/alta-fantasia-client-beta
SESSION_SECRET=
